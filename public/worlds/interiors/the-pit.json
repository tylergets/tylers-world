    {
      "id": "pit.barker",
      "type": "folk.villager",
      "tile": [
        16,
        2
      ],
      "facing": "south",
      "props": {
        "name": "Barker Quill",
        "title": "Ringmaster",
        "noSmallTalk": true,
        "roam": 1,
        "voice": {
          "pitch": 1.05,
          "rate": 34,
          "timbre": "square"
        }
      },
      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "not": {
                    "flag": "met"
                  }
                },
                "to": "hello"
              },
              {
                "to": "again"
              }
            ]
          },
          "hello": {
            "text": [
              "LADIES AND GENTLEMEN AND WHATEVER WALKED IN JUST NOW.",
              "Barker Quill. I run the card, ring the gong, and take no responsibility for anything that happens on the sand."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "The bell kid returns! Crowd goes mild!",
            "then": "menu"
          },
          "menu": {
            "text": "What do you want to know?",
            "choices": [
              {
                "text": "How do I fight?",
                "to": "how"
              },
              {
                "text": "What do I win?",
                "to": "win"
              },
              {
                "text": "Who are they?",
                "to": "who"
              },
              {
                "text": "Nothing. Just looking.",
                "to": "end"
              }
            ]
          },
          "how": {
            "text": [
              "Buy a gun off Ledger, or bring your own. Step onto the sand. Draw.",
              "The moment iron is out, all three fighters come for you. Airsoft, so nobody dies, but five hearts go fast. Holster the gun and they stand down. Cheap trick. Legal trick."
            ],
            "then": "menu"
          },
          "win": {
            "text": [
              "Put all three of them flat at the same time and the house pays fifty a head. Clean sweep, hundred and fifty coins, and I say your name very loudly.",
              "Get shot up? Stitch is in the corner. He is not cheap and he is not gentle."
            ],
            "then": "menu"
          },
          "who": {
            "text": [
              "Knuckles, the champion. Hits like a door. Vex, who has never lost, allegedly. And Tiny.",
              "Do not ask Tiny about the name."
            ],
            "then": "menu"
          }
        }
      }
    },
