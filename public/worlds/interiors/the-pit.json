  "npcs": [
    {
      "id": "pit.knuckles",
      "type": "folk.pitfighter",
      "tile": [
        12,
        10
      ],
      "facing": "east",
      "props": {
        "name": "Knuckles Brannock",
        "title": "Pit Champion",
        "roam": 3,
        "noSmallTalk": true,
        "armedSecurity": true,
        "sparring": true,
        "alertLine": "Knuckles Brannock: \"FINALLY.\" Every fighter in the Pit draws.",
        "skin": "tan",
        "hair": "black"
      },
      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "not": {
                    "flag": "met"
                  }
                },
                "to": "hello"
              },
              {
                "to": "again"
              }
            ]
          },
          "hello": {
            "text": [
              "New meat. Good. The old meat was getting predictable.",
              "Knuckles. Champion, four seasons. The belt on Ledger's counter is a replica. The real one is on me."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Back for more, bell kid?",
            "then": "menu"
          },
          "menu": {
            "text": "Talk fast. I stretch while I listen.",
            "choices": [
              {
                "text": "How does this work?",
                "to": "rules"
              },
              {
                "text": "You don't look that tough.",
                "to": "taunted"
              },
              {
                "text": "Later.",
                "to": "end"
              }
            ]
          },
          "rules": {
            "text": "House rules. You draw a gun in here, all three of us draw. Put all three of us on the sand at once and the house pays out. Stitch patches the losers. Nobody keeps a grudge.",
            "then": "menu"
          },
          "taunted": {
            "text": "That is what the last champion said. He runs a furniture shop now. Nice guy. Draw when you are ready.",
            "then": "end"
          }
        }
      }
    },
    {
      "id": "pit.vex",
      "type": "folk.pitfighter",
      "tile": [
        17,
        13
      ],
      "facing": "west",
      "props": {
        "name": "The Widow Vex",
        "title": "Undefeated (allegedly)",
        "roam": 3,
        "noSmallTalk": true,
        "armedSecurity": true,
        "sparring": true,
        "alertLine": "The Widow Vex: \"FINALLY.\" Every fighter in the Pit draws.",
        "voice": {
          "pitch": 1.12,
          "rate": 26,
          "timbre": "square"
        },
        "hair": "white"
      },
      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "not": {
                    "flag": "met"
                  }
                },
                "to": "hello"
              },
              {
                "to": "again"
              }
            ]
          },
          "hello": {
            "text": [
              "Do not stand in the middle of the sand. That is where things happen to people.",
              "Vex. The \"Widow\" part is a long story and every version of it is true."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Still upright. I am mildly impressed.",
            "then": "menu"
          },
          "menu": {
            "text": "Yes?",
            "choices": [
              {
                "text": "How does this work?",
                "to": "rules"
              },
              {
                "text": "Undefeated? Really?",
                "to": "taunted"
              },
              {
                "text": "Later.",
                "to": "end"
              }
            ]
          },
          "rules": {
            "text": "House rules. You draw a gun in here, all three of us draw. Put all three of us on the sand at once and the house pays out. Stitch patches the losers. Nobody keeps a grudge.",
            "then": "menu"
          },
          "taunted": {
            "text": "Allegedly. Knuckles says he put me down once. Knuckles also says the moon is a lamp. Draw and find out.",
            "then": "end"
          }
        }
      }
    },
