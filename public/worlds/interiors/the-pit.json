      "props": {
        "name": "Stitch",
        "title": "Cutman",
        "roam": 1,
        "voice": {
          "pitch": 0.9,
          "rate": 20,
          "timbre": "triangle"
        }
      },
      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "hurt": true
                },
                "to": "hurt"
              },
              {
                "to": "fine"
              }
            ]
          },
          "hurt": {
            "text": "Sit. You are leaking.",
            "choices": [
              {
                "text": "Patch me up. (40 coins)",
                "when": {
                  "coins": 40
                },
                "do": [
                  {
                    "coins": -40
                  },
                  {
                    "heal": true
                  }
                ],
                "to": "patched"
              },
              {
                "text": "I cannot afford it.",
                "when": {
                  "not": {
                    "coins": 40
                  }
                },
                "to": "broke"
              },
              {
                "text": "I will walk it off.",
                "to": "end"
              }
            ]
          },
          "patched": {
            "text": "There. Good as new, apart from the bruise, which is yours to keep.",
            "then": "end"
          },
          "broke": {
            "text": "Then bleed cheaper. Ledger buys BBs back, if you have any left.",
            "then": "end"
          },
          "fine": {
            "text": "Nothing to stitch. Come back when there is. There will be.",
            "then": "end"
          }
        },
        "greetings": {
          "acquaintance": [
            "Table is clean. Needle is clean. That is more than most people get in here.",
            "Ledger sends me the losers. Barker sends me the winners. Same blood, different paperwork.",
            "The crow keeps stealing my gauze. I have stopped fighting it. It is a better cutman than most.",
            "Do not sit on the chair unless you are bleeding. It is the only one I have."
          ],
          "friend": [
            "You are the only one who comes back with fewer holes than last time. I take that as a compliment.",
            "Vex asked me what I charge you. I told her the same as everyone. I lied. Do not tell Ledger.",
            "Knuckles bled on my table again and called it a scratch. I have a jar for the scratches. It is full.",
            "Sit down anyway. Nothing to stitch, but those benches are bad for the back."
          ],
          "close": [
            "There you are. Chair is yours whether you are leaking or not.",
            "Forty coins for everyone else. I have not decided about you. Do not push it.",
            "I keep a clean rag with your name on it. Do not read anything into that. Read a little."
          ]
        }
      }
    }
