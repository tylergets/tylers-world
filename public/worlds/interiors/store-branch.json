              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Just warming up.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Sticks, pebbles and mushrooms. Fruit goes soft on the shelf and I'll not have it.",
            "then": "menu"
          },
          "after": {
            "text": "Right you are.",
            "then": "menu"
          },
