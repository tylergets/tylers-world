      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Come on in, the stove's lit.",
              "Hollis. I pay better than Marla over the ridge, but I'm choosier about what I'll take."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Stove's still going. What do you need?",
            "then": "menu"
          },
          "menu": {
            "text": "Trading, or just warming up?",
            "choices": [
              {
                "text": "Trading.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Just warming up.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Sticks, pebbles and mushrooms. Fruit goes soft on the shelf and I'll not have it.",
            "then": "menu"
          },
          "after": {
            "text": "Right you are.",
            "then": "menu"
          },
          "bye": {
            "text": "Pull the door to behind you, it sticks."
          }
        },
        "greetings": {
          "acquaintance": [
            "Feed's in, hardware's in, and the dry goods are drier than the sign promises.",
            "Loafers' chair is free. Whoever was in it went home when I stopped laughing at him.",
            "If that is fruit in your bag, keep it in your bag. I said it once and I meant it once.",
            "Somebody bought the shovel. I have ordered another and it will come when the cart comes."
          ],
          "friend": [
            "Fern was in asking after you. I said you paid on time, which from me is a speech.",
            "I have not been over the ridge in a year. Marla can come to me if she wants a look at my prices.",
            "You buy more shot than a person needs for mushrooms. I am not asking. I am noticing.",
            "The door has stuck since I bought the place. I sell hammers. I know how that looks."
          ],
          "close": [
            "Pot's on the stove. Pour your own, my hands are full of feed.",
            "Take what you need off the shelf and tell me after. I know where you live.",
            "I kept the last of the apples back for you. Do not tell the shelf, it thinks I have standards."
          ]
        }
      }
    }
