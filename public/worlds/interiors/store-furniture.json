            "text": [
              "Alder. Tables, chairs, and the occasional thing nobody ordered.",
              "I put a few pieces out each morning. Tomorrow's floor will be different."
            ],
            "do": { "set": "met" },
            "then": "menu"
          },
          "again": { "text": "Today's pieces are still today's pieces.", "then": "menu" },
