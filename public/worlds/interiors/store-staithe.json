      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Wipe them. I know it is a fen. Wipe them anyway.",
              "Wilf. Half of what I sell is board and nails, and the other half is why you needed board and nails."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Dry in here, at least. What is it?",
            "then": "menu"
          },
          "menu": {
            "text": "Trading?",
            "choices": [
              {
                "text": "Trading.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Just dripping on your floor.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Alder, marigold and anything that grew on a bank. Stone I sell -- hard standing is money here.",
            "then": "menu"
          },
          "after": {
            "text": "Right you are.",
            "then": "menu"
          },
          "bye": {
            "text": "Boards, mind. Not the shortcut."
          }
        },
        "greetings": {
          "acquaintance": [
            "Boards are in. Nails are in. Reed has had the thatch off half the village so I expect to sell both.",
            "Marsh brought eel baskets to trade. They smell of what they are for. They are hanging out the back until they do not.",
            "You came by the boards. Good. Meg finds the ones who do not, eventually, and she charges.",
            "Stone is up. Stone is always up. The fen eats hard standing and I sell the fen its dinner."
          ],
          "friend": [
            "Tarn came over to borrow a hammer. Neighbour, more or less. Borrower, entirely.",
            "You have dripped on my floor so many times I have started to think of it as your side of the shop.",
            "I saw you take the shortcut. I saw you come back for the boards. I am not gloating, I am stocking.",
            "Marigold you brought me went in the window. Only colour in Sedgewater that is not brown or green or wet."
          ],
          "close": [
            "Do not bother wiping. I have given up on the floor and I have very nearly given up on you.",
            "The corner by the boards is the dry one. It is yours while you are in.",
            "Marsh asked if you were family. I said near enough that you pay the family price, which is the same price."
          ]
        }
      }
    }
