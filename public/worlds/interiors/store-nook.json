      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "not": {
                    "flag": "met"
                  }
                },
                "to": "hello"
              },
              {
                "when": {
                  "visits": 6
                },
                "to": "regular"
              },
              {
                "to": "again"
              }
            ]
          },
          "hello": {
            "text": [
              "Well now. You'll be the one who took the place up by the pines.",
              "Marla. I keep the shelves, and I'll take most things off your hands -- within reason."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Back again. Shelves are where you left them.",
            "then": "menu"
          },
          "regular": {
            "text": "You're in here more than I am. Go on, help yourself.",
            "then": "menu"
          },
          "menu": {
            "text": "What'll it be?",
            "choices": [
              {
                "text": "Let's trade.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "I brought you apples.",
                "when": {
                  "all": [
                    {
                      "has": {
                        "type": "item.apple",
                        "count": 3
                      }
                    },
                    {
                      "room": {
                        "type": "item.flower",
                        "count": 1
                      }
                    },
                    {
                      "not": {
                        "flag": "paid.apples"
                      }
                    }
                  ]
                },
                "to": "apples"
              },
              {
                "text": "What do you buy?",
                "when": {
                  "not": {
                    "flag": "asked"
                  }
                },
                "to": "buys"
              },
              {
                "text": "You must do well out of me.",
                "when": {
                  "coins": 250
                },
                "to": "rich"
              },
              {
                "text": "That's all for now.",
                "to": "bye"
              }
            ]
          },
          "buys": {
            "text": [
              "Shells, mostly. There's a fellow along the coast road pays silly money for them.",
              "Sticks and pebbles I'll take too, but don't go planning your retirement on it."
            ],
            "do": {
              "set": "asked"
            },
            "then": "menu"
          },
          "apples": {
            "text": "Three, and not a bruise on one of them. Here -- coin for your trouble, and take a flower for the window.",
            "do": [
              {
                "take": {
                  "type": "item.apple",
                  "count": 3
                }
              },
              {
                "give": {
                  "type": "item.flower",
                  "count": 1
                }
              },
              {
                "coins": 40
              },
              {
                "set": "paid.apples"
              }
            ],
            "then": "menu"
          },
          "rich": {
            "text": "Carrying that much about with you? Half the town would call that showing off.",
            "then": "menu"
          },
          "after": {
            "text": "Pleasure doing business.",
            "then": "menu"
          },
          "bye": {
            "text": "Mind the step on your way out."
          }
        }
      }
    }
  ],
