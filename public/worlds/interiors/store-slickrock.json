      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Shut it behind you. The dust does not pay for anything.",
              "Marl. Last shop before a very long way down, which is a joke I have made every day for nine years."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Still here. Still dusty.",
            "then": "menu"
          },
          "menu": {
            "text": "Buying, or sheltering?",
            "choices": [
              {
                "text": "Buying.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Sheltering.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Stone, wood and anything that flowered. Water I sell and never buy, before you ask.",
            "then": "menu"
          },
          "after": {
            "text": "Right you are.",
            "then": "menu"
          },
          "bye": {
            "text": "Sit where you like. Do not lean on the shelves."
          }
        },
        "greetings": {
          "acquaintance": [
            "Water is full price. It is always full price. Mesa's jars are the only competition and she does not sell.",
            "Flint brought a polished stone in to trade. I told him a stone is a stone. He told me it was nine hours. We are not speaking.",
            "Bly says there is a number for how much dust comes in when the door opens. I said the number is all of it.",
            "Sora's juniper is under the counter. Not for sale. Not officially. Ask right and I might not hear you."
          ],
          "friend": [
            "Wend was in for pumpkin seed. Again. Nothing grows out here and she plants it anyway, and it grows. Do not tell her it should not.",
            "Pike fixed the shelf you leaned on. So now you know what happens. It costs me Pike.",
            "You have been down the long way and back. Most people go down once. The shop looks the same from either direction.",
            "Nine years of the same joke and you laughed at it. I have not decided if that is kindness or bad taste."
          ],
          "close": [
            "Sit on the counter. The shelves you cannot lean on. The counter has given up arguing.",
            "There is water in the jug that is not for sale. It is for you. Do not make it a habit, I cannot afford you.",
            "Dust off. Or do not. It is in everything already and so are you."
          ]
        }
      }
    }
