      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "not": {
                    "flag": "met"
                  }
                },
                "to": "hello"
              },
              {
                "to": "again"
              }
            ]
          },
          "hello": {
            "text": [
              "Linnet. I put the rail out at nine and I take what is left of it in at seven.",
              "Three shirts, a hat and a pair of sunglasses. Never the same five twice."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Rail is where I left it. Have a look.",
            "then": "menu"
          },
          "menu": {
            "text": "Anything take your eye?",
            "choices": [
              {
                "text": "Show me today’s rail.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "How do I put it on?",
                "to": "wearing"
              },
              {
                "text": "What comes in tomorrow?",
                "to": "tomorrow"
              },
              {
                "text": "Just looking.",
                "to": "bye"
              }
            ]
          },
          "wearing": {
            "text": "Press G and you have your wardrobe. Move with the arrows, E to put a thing on or take it off again. Your old one goes back in the bag — nothing gets lost in here.",
            "then": "menu"
          },
          "tomorrow": {
            "text": [
              "Ten shirts on the books, ten hats, ten pairs of glasses. Five of them out at a time.",
              "So no, I will not fetch one from the back. Come by in the morning."
            ],
            "then": "menu"
          },
          "after": {
            "text": "Wear it in good health. I will buy it back off you when you tire of it.",
            "then": "menu"
          },
          "bye": {
            "text": "Suit yourself. That is rather the idea."
          }
        }
      }
    }
