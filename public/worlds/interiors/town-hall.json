  "npcs": [
    {
      "id":"official.planner","type":"folk.villager","tile":[4,1],"facing":"south",
      "props":{"name":"Mara Vale","title":"Urban Planner","office":"planner","voice":{"pitch":1.08,"rate":23,"timbre":"triangle"}},
      "dialog":{"start":"desk","nodes":{"desk":{"text":"Let us put the whole town on the drafting table. I will protect buildings and occupied ground; you decide what the land should become.","then":"end"}}}
    },
    {
      "id":"official.wildlife","type":"folk.fisher","tile":[4,12],"facing":"south",
      "props":{"name":"Reed Fen","title":"Fish & Wildlife Warden","office":"wildlife","voice":{"pitch":0.9,"rate":21,"timbre":"sawtooth"}},
      "dialog":{"start":"desk","nodes":{"desk":{"text":"We can stock water or set bait, but every habitat has a limit.","then":"end"}}}
    },
    {
      "id":"official.mayor","type":"folk.villager","tile":[24,3],"facing":"south",
      "props":{"name":"Mayor Bell","title":"Mayor","voice":{"pitch":0.96,"rate":22,"timbre":"square"}},
      "dialog":{"start":"hello","nodes":{
        "hello":{"text":"Welcome to the Mayor's Office. We can discuss the town, or put your coin behind a lasting improvement.","then":"menu"},
        "menu":{"text":"What is on your mind?","choices":[
          {"text":"How is the town doing?","to":"town"},
          {"text":"Add a second story to my home — 1800 coin.","when":{"houseStories":1,"coins":1800},"do":[{"coins":-1800},{"houseStories":2}],"to":"second"},
          {"text":"I need 1800 coin for the second story.","when":{"all":[{"houseStories":1},{"not":{"coins":1800}}]},"to":"short"},
          {"text":"Add a third story to my home — 3600 coin.","when":{"houseStories":2,"coins":3600},"do":[{"coins":-3600},{"houseStories":3}],"to":"third"},
          {"text":"I need 3600 coin for the third story.","when":{"all":[{"houseStories":2},{"not":{"coins":3600}}]},"to":"short"},
          {"text":"Is my home complete?","when":{"houseStories":3},"to":"complete"},
          {"text":"That is all for now.","to":"endline"}
        ]},
        "town":{"text":"The town is what we keep in common: sound paths, living water, room for wildlife, and neighbors willing to invest in one another.","then":"menu"},
        "second":{"text":"Approved and funded. The new stair and second floor are ready at home.","then":"end"},
        "third":{"text":"The final floor is funded. Your home is complete at three stories.","then":"end"},
        "short":{"text":"Keep the proposal. Public business is better done without pretending the purse is ready.","then":"end"},
        "complete":{"text":"Three stories, fully approved. Any higher would need a different kind of town.","then":"end"},
        "endline":{"text":"My door is open when the town gives you something else to bring in.","then":"end"}
      }}
    },
    {
      "id":"official.cheater","type":"folk.tinker","tile":[24,15],"facing":"south",
      "props":{"name":"Glitch","title":"Director of Exceptions","office":"cheats","voice":{"pitch":1.28,"rate":28,"timbre":"square"}},
      "dialog":{"start":"desk","nodes":{"desk":{"text":"Every rule has a form, and every form has an exception box. Mine are already checked.","then":"end"}}}
    }
