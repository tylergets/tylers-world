      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Shut it behind you, the wind comes straight down the gap.",
              "Edda. Named the place after a sheep, and he was better company than most who come in."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Range is lit. What are you after?",
            "then": "menu"
          },
          "menu": {
            "text": "Trading, or thawing out?",
            "choices": [
              {
                "text": "Trading.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Why the shell on the shelf?",
                "to": "shell"
              },
              {
                "text": "Thawing out.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Thistledown, mushrooms and kindling. Pebbles I have a valley full of.",
            "then": "menu"
          },
          "shell": {
            "text": [
              "Came up the road in somebody's pocket forty years back.",
              "Nearest sea is four days that way and I have never once been. It stays where it is."
            ],
            "then": "menu"
          },
          "after": {
            "text": "Right.",
            "then": "menu"
          },
          "bye": {
            "text": "Stand by the range as long as you like. Just shut the door."
          }
        },
        "greetings": {
          "acquaintance": [
            "Heather's fleece came in and the whole shop smells of sheep. That is the smell of a shop doing well up here.",
            "Briar's goats got at the kindling stack. What they left, I am selling at goat prices.",
            "Dell let you through the gate, then. He does not let everyone through. He has let me through twice.",
            "Rook was down off the tarn for apples. Said nothing, paid, went back. That is a good customer."
          ],
          "friend": [
            "Nan asked me if you were staying. I told her the wind has not blown you out yet and it has tried.",
            "Gale wants a milestone by the door reading how far it is to the sea. I told him nobody in here is going.",
            "You brought me thistledown by the sack. The wether would have eaten it. I am still deciding whether I miss him more.",
            "Mushrooms you left were the good ones. I did not tell Heather. She would have wanted the good ones."
          ],
          "close": [
            "Stool by the range is yours. I moved Nan's knitting off it and she can argue with me later.",
            "The shell on the shelf. You can hold it. Nobody holds it. Put it back where it was.",
            "He would have liked you, the wether. He liked anyone who stood in the door letting the wind in and did not apologise."
          ]
        }
      }
    }
