      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [{"when": {"flag": "met"}, "to": "again"}, {"to": "hello"}]
          },
          "hello": {
            "text": [
              "Shut it behind you, the wind comes straight down the gap.",
              "Edda. Named the place after a sheep, and he was better company than most who come in."
            ],
            "do": {"set": "met"},
            "then": "menu"
          },
          "again": {
            "text": "Range is lit. What are you after?",
            "then": "menu"
          },
          "menu": {
            "text": "Trading, or thawing out?",
            "choices": [
              {"text": "Trading.", "do": {"shop": true}, "to": "after"},
              {"text": "What'll you take?", "to": "takes"},
              {"text": "Why the shell on the shelf?", "to": "shell"},
              {"text": "Thawing out.", "to": "bye"}
            ]
          },
          "takes": {
            "text": "Thistledown, mushrooms and kindling. Pebbles I have a valley full of.",
            "then": "menu"
          },
          "shell": {
            "text": [
              "Came up the road in somebody's pocket forty years back.",
              "Nearest sea is four days that way and I have never once been. It stays where it is."
            ],
            "then": "menu"
          },
          "after": {
            "text": "Right.",
            "then": "menu"
          },
          "bye": {
            "text": "Stand by the range as long as you like. Just shut the door."
          }
        }
      }
    }
