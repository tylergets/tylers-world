  "npcs": [
    {
      "id": "airport.tsa.lead", "type": "folk.tsa", "tile": [12, 39], "facing": "south",
      "props": { "name": "Agent Rook", "title": "TSA Police", "noSmallTalk": true, "roam": 1, "armedSecurity": true },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "Shoes can stay on. Tools, fish, turnips, and suspiciously heavy furniture go in a tray.", "then": "end" } } }
    },
    {
      "id": "airport.tsa.east", "type": "folk.tsa", "tile": [27, 39], "facing": "south",
      "props": { "name": "Agent Vale", "title": "TSA Police", "noSmallTalk": true, "roam": 1, "armedSecurity": true },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "Walk through the scanner one at a time. The green light means you are probably not a rake.", "then": "end" } } }
    },
    {
      "id": "airport.gate.a1", "type": "folk.villager", "tile": [5, 5], "facing": "west",
      "props": { "name": "June", "title": "Gate A1 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "Gate A1 handles TW 104 to Cloudbreak Cay at 06:30 daily. Present your ticket at the blue podium when the board says BOARDING.", "then": "end" } } }
    },
    {
      "id": "airport.gate.b1", "type": "folk.villager", "tile": [33, 5], "facing": "east",
      "props": { "name": "Orin", "title": "Gate B1 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "TW 218 for Copperglass Mesa leaves Gate B1 at 10:15 daily. Boarding opens one hour before departure.", "then": "end" } } }
    },
    {
      "id": "airport.gate.a2", "type": "folk.villager", "tile": [5, 19], "facing": "west",
      "props": { "name": "Mica", "title": "Gate A2 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "Moonfen is TW 332 from Gate A2, departing at 14:00 daily. The podium scans route tickets from your bag.", "then": "end" } } }
    },
    {
      "id": "airport.gate.b2", "type": "folk.villager", "tile": [33, 19], "facing": "east",
      "props": { "name": "Pella", "title": "Gate B2 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "TW 446 to Sunspoke Coast departs Gate B2 at 19:30 daily. Your ticket remains valid if you miss today's flight.", "then": "end" } } }
    },
    {
      "id": "airport.gate.a3", "type": "folk.villager", "tile": [5, 32], "facing": "west",
      "props": { "name": "Sol", "title": "Gate A3 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "A3 is the last gate down. If you can still see security, you have not walked far enough.", "then": "end" } } }
    },
    {
      "id": "airport.gate.b3", "type": "folk.villager", "tile": [33, 32], "facing": "east",
      "props": { "name": "Cairn", "title": "Gate B3 Agent", "noSmallTalk": true, "roam": 1 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "B3 boards when the aircraft arrives, which is less circular than it sounds.", "then": "end" } } }
    },
    {
      "id": "airport.traveler", "type": "folk.villager", "tile": [17, 25], "facing": "south",
      "props": { "name": "Tern", "title": "Frequent Flyer", "roam": 5 },
      "dialog": { "start": "hello", "nodes": { "hello": { "text": "I arrived early enough to become part of the terminal furniture.", "then": "end" } }, "greetings": {
        "acquaintance": [
          "Gate A2 is still deciding. I have moved benches three times so it feels like progress.",
          "The moving walkway goes north. I take it. Then I walk back. It is the only round trip in this building.",
          "Agent Rook made me take a turnip out of my bag. It has its own tray now. It is doing better than I am.",
          "The board says on time. I have learned to read that as a mood, not a fact."
        ],
        "friend": [
          "You are the only person here who is not waiting for anything. I find that very restful to stand next to.",
          "June let me board and then unboard. I count as a drill, apparently. Glad to be useful.",
          "I have a favourite bench now. B3, second from the wall. If you see somebody on it, that is a stranger.",
          "Pella made me stand on the walkway with conviction. I did. It went the same speed."
        ],
        "close": [
          "There you are. Sit. The gate is not going anywhere and neither am I.",
          "I told Cairn you were my ride. It is not true and I would like it to be.",
          "Nobody visits an airport. You visit me. I have noticed the difference."
        ]
      } }
    }
  ],
