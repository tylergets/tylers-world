      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Door's open. It is always open, the frame is warped.",
              "Cass. Half this shop washed up on the outer beach and I will not pretend otherwise."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Back round. Sit down if your legs have gone.",
            "then": "menu"
          },
          "menu": {
            "text": "Trading, or sheltering?",
            "choices": [
              {
                "text": "Trading.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Sheltering, mostly.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Shells, pebbles and driftwood. Anything that grows, I have too much of and so does everyone.",
            "then": "menu"
          },
          "after": {
            "text": "Pleasure.",
            "then": "menu"
          },
          "bye": {
            "text": "Mind the step down. Everyone forgets the step down."
          }
        },
        "greetings": {
          "acquaintance": [
            "Something new on the shelf. It came in on the tide, so I could not tell you what it is for.",
            "Coral had a whole net's worth of nothing and sold me the nothing. It is on the left, by the sticks.",
            "Selkie burns half the shells I would buy. We have an understanding, and it is that we do not talk about it.",
            "Somebody asked if the apples washed up too. No. The apples are the one thing in here that came by boat on purpose."
          ],
          "friend": [
            "Otto says the whole shop would float if the tide got in. I told him the shelves would go first, then me, then the stock.",
            "You bring me more pebbles than the beach does. I am not complaining. I am wondering where you keep them.",
            "Marnie came in from the far shore with a shell as big as her head. Would not sell. Came in to show me.",
            "Yarrow has not been down in a while. If you are going up, tell him the sticks are still here and so am I."
          ],
          "close": [
            "Step down. Yes, I know you know. I say it to everyone I like.",
            "Pull a crate up. There is nothing on the tide and I am glad of the company.",
            "Half of this washed up and the other half you sold me. I am not sure which half I trust more."
          ]
        }
      }
    }
