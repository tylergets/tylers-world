      "dialog": {
        "start": "open",
        "nodes": {
          "open": {
            "branch": [
              {
                "when": {
                  "flag": "met"
                },
                "to": "again"
              },
              {
                "to": "hello"
              }
            ]
          },
          "hello": {
            "text": [
              "Everything in here has been carried round the ring at least once. Price reflects it.",
              "Oram. Only shop in the bowl, which I am told is not the same as the best shop in the bowl."
            ],
            "do": {
              "set": "met"
            },
            "then": "menu"
          },
          "again": {
            "text": "Round again. What is it this time?",
            "then": "menu"
          },
          "menu": {
            "text": "Trading, or warming up?",
            "choices": [
              {
                "text": "Trading.",
                "do": {
                  "shop": true
                },
                "to": "after"
              },
              {
                "text": "What'll you take?",
                "to": "takes"
              },
              {
                "text": "Warming up.",
                "to": "bye"
              }
            ]
          },
          "takes": {
            "text": "Stone, wood and mushrooms. Not the ones off the warm ground, mind. I can tell.",
            "then": "menu"
          },
          "after": {
            "text": "Right you are.",
            "then": "menu"
          },
          "bye": {
            "text": "Mind the step. It is warm."
          }
        },
        "greetings": {
          "acquaintance": [
            "New stock came round the ring on somebody's back. You can tell which shelf by the sweat on the labels.",
            "Basalt sends the bread over warm. It is the one thing in here I did not price for the carrying.",
            "The sticks are dry. Everything in Ashkettle is dry, but these are dry the useful way.",
            "Tally was in from the terraces for seed. Told her the pumpkin lot came from the far side and she bought it anyway."
          ],
          "friend": [
            "Ro says the water is fine. Ro always says the water is fine. I sell apples, which I can vouch for.",
            "You have been picking off the warm ground again. I can smell it. Leave those on the far side with Vesper.",
            "Ember wants glaze from me. I want customers from her. Neither of us is getting rich on the deal.",
            "If you are looking for the best shop in the bowl, it is still not here. I have made peace with that."
          ],
          "close": [
            "Sit on the crate by the step. It is the warm one. I keep it for you.",
            "I carried the apples round the ring myself this time. Do not ask what that does to a man's knees.",
            "Doorstop stone is yours if you want it. You have paid for it several times over."
          ]
        }
      }
    }
